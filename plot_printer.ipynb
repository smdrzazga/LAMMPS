    "\n",
    "N = 150\n",
    "\n",
    "with open(centers_file, 'r') as f:\n",
    "    centers = np.array([line.split()[-1] for line in f], dtype=np.float64)\n",
    "    centers = centers.reshape((N, N))\n",
    "    centers /= np.sum(centers) / centers.shape[0] / centers.shape[1]\n",
    "\n",
    "N = 150\n",
    "with open(directors_file, 'r') as f:\n",
    "    directors = np.array([line.split()[-3:] for line in f], dtype=np.float16)\n",
    "    directors = directors.reshape((N, N, 3))\n",
    "\n",
    "with open(polarizations_file, 'r') as f:\n",
    "    directors = np.array([line.split()[-3:] for line in f], dtype=np.float16)\n",
    "    directors = directors.reshape((150, 150, 3))\n",
    "\n",
    "with open(directors_file, 'r') as f:\n",
    "    polarizations = np.array([line.split()[-3:] for line in f], dtype=np.float16)\n",
    "    polarizations = polarizations.reshape((N, N, 3))\n",
    "    for i in range(150):\n",
    "        for j in range(150):\n",
    "            norm = np.linalg.norm(polarizations[i,j])\n",
    "            polarizations[i,j] /= norm \n",
    "\n",
    "Dx = np.array([[-1, 0, 1], [-2, 0, 2], [-1, 0, 1]])\n",
    "Dz = np.array([[-1, -2, -1], [0, 0, 0], [1, 2, 1]])\n",
    "\n",
    "dFydz = fftconvolve(directors[:, :, 1], Dz, mode='same')\n",
    "dFxdz = fftconvolve(directors[:, :, 0], Dz, mode='same')\n",
    "dFzdx = fftconvolve(directors[:, :, 2], Dx, mode='same')\n",
    "dFydx = fftconvolve(directors[:, :, 1], Dx, mode='same')\n",
    "\n",
    "curl = np.zeros((N, 2*N, 3))\n",
    "curl[:, :, 0] = -1*dFydz\n",
    "curl[:, :, 1] = dFxdz - dFzdx\n",
    "curl[:, :, 2] = dFydx\n",
    "\n",
    "twist = np.sum(directors*curl, axis=2)\n",
