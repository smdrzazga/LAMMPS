    "centers_file       = paths[\"matrices_centers\"] + r\"\\centers_bulk_two_domains_2x.lammpstrj.txt\"\n",
    "directors_file     = paths[\"matrices_directors\"] + r\"\\directors_bulk_two_domains_2x.lammpstrj.txt\"\n",
    "polarizations_file = paths[\"matrices_polarization\"] + r\"\\polarization_bulk_two_domains_2x.lammpstrj.txt\"\n",
    "twist_file         = paths[\"matrices\"] + r\"\\domains_director_twist.txt\"\n",
