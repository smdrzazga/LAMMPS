    "def ellipse(x, A, B):\n",
    "    return B**2*(1 - (x/A)**2)\n",
    "    \n",
    "def getData(file, N=150):\n",
    "    data = np.zeros((N, N, 3), dtype=np.float64)\n",
    "    with open(file, 'r') as f:\n",
    "        for line in f:\n",
    "            i, j, *director = line.split()\n",
    "            i, j = int(i), int(j)\n",
    "            data[i,j, :] = director\n",
    "    return data\n",
    "\n",
    "def getAxes(data, i, delta):\n",
    "    x = data[:, i:i+delta, 0].flatten()\n",
    "    x -= np.average(x)\n",
    "\n",
    "    y = data[:, i:i+delta, 1].flatten()\n",
    "    y -= np.average(y)\n",
    "\n",
    "    A = np.stack([x**2, y**2]).T\n",
    "    b = np.ones_like(x)\n",
    "    w = np.linalg.lstsq(A, b, rcond=-1)[0].squeeze()\n",
    "\n",
    "    return np.sqrt(1/w)\n",
    "\n",
    "\n",
    "def plotEllipsisAxes(data, N: int, delta: int):\n",
    "    span = range(2, N-2-delta, delta)\n",
    "    x = np.array([i for i in span])\n",
    "\n",
    "    x_data = np.linspace(0, 1, len(x))\n",
    "    fit = []\n",
    "\n",
    "    for i in span:\n",
    "        fit.append(getAxes(data, i, delta))\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(6.6, 4.8))\n",
    "    fit = np.array(fit)\n",
    "\n",
    "    plt.plot(x_data, fit[:,1], ls='--', c='black')\n",
    "    plt.plot(x_data, fit[:,0], ls='--', c='r')\n",
    "    plt.xlabel(r'$d\\;\\;\\mathrm{[box\\;size]}$')\n",
    "    # plt.ylabel(r'${V_{LJ} \\;\\;[\\epsilon]}$')\n",
    "    ax.set_ylim(0, 0.9)\n",
    "    return fig, ax\n",
    "\n",
    "def fitEllipsis(data, slice_id):\n",
    "    x = data[:,slice_id,0]\n",
    "    x -= np.average(x)\n",
    "\n",
    "    y = data[:,slice_id,1]\n",
    "    y -= np.average(y)\n",
    "\n",
    "    A = np.stack([x**2, y**2]).T\n",
    "    b = np.ones_like(x)\n",
    "    w = np.linalg.lstsq(A, b)\n",
    "\n",
    "    ex, ey = np.sqrt(1/w[0])\n",
    "    print(\"Ex: \", ex, \"\\nEy: \", ey)\n",
    "    w = w[0].squeeze()\n",
    "    return w\n",
    "\n",
    "def plotEllipsis(w):\n",
    "    xlin = np.linspace(-0.1, 0.1, 300)\n",
    "    ylin = np.linspace(-0.5, 0.5, 300)\n",
    "    X, Y = np.meshgrid(xlin, ylin)\n",
    "\n",
    "    Z = w[0]*X**2 + w[1]*Y**2\n",
    "    ex, ey = np.sqrt(1/w)\n",
    "\n",
    "    fig, axe = plt.subplots()\n",
    "    axe.set_aspect('equal')\n",
    "    axe.contour(X, Y, Z, [1])\n",
    "    axe.axis(\"off\")\n",
    "    return fig, axe\n",
    "\n",
    "def addEllipsisSubplot(figure, file, position: list):\n",
    "    newax = figure.add_axes(position, anchor='NE', zorder=10)\n",
    "\n",
    "    imLeft = plt.imread(file)\n",
    "    newax.patch.set_alpha(0.001)\n",
    "    newax.imshow(imLeft)\n",
    "    newax.tick_params(left = False, right = False , labelleft = False , \n",
    "                    labelbottom = False, bottom = False) \n",
    "    return figure"
   ]
  },
