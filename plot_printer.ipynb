    "import numpy as np\n",
    "from scipy.signal import convolve2d as conv2\n",
    "\n",
    "# Define the M matrix\n",
    "M = np.array([\n",
    "    [1, -3, 3, -1],\n",
    "    [-1, 4, -5, 2],\n",
    "    [0, 1, 0, -1],\n",
    "    [0, 0, 2, 0]\n",
    "]) * 0.5\n",
    "\n",
    "# Vectors u and up\n",
    "u = np.array([0.125, 0.25, 0.5, 1])\n",
    "up = np.array([0.75, 1, 1, 0])\n",
    "\n",
    "# Compute kernels\n",
    "d = up.transpose() @ M    # Differentiation kernel\n",
    "k = u.transpose() @ M     # Smoothing kernel\n",
    "\n",
    "# Inner convolutions (generating 1D kernels)\n",
    "dk = np.convolve(d, k, mode='full')\n",
    "kk = np.convolve(k, k, mode='full')\n",
    "\n",
    "# Reshape for 2D convolution\n",
    "dk_2d = dk[:, np.newaxis] @ kk[np.newaxis, :]\n",
    "kk_2d = kk[:, np.newaxis] @ dk[np.newaxis, :]\n",
    "\n",
    "dFydz = fftconvolve(directors[:, :, 1], dk_2d, mode='same')\n",
    "dFxdz = fftconvolve(directors[:, :, 0], dk_2d, mode='same')\n",
    "dFzdx = fftconvolve(directors[:, :, 2], kk_2d, mode='same')\n",
    "dFydx = fftconvolve(directors[:, :, 1], kk_2d, mode='same')\n",
    "\n",
    "twist = -1*directors[:, :, 0]*dFydz + directors[:, :, 1]*(dFxdz - dFzdx) + directors[:, :, 2]*dFydx\n",
    "twist = twist**2\n",
    "plt.imshow(twist, cmap='copper')\n",
    "plt.colorbar()"
   ]
  }
